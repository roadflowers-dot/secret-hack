# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
# "Authorized JavaScript origins" 에 사이트 주소(예: http://localhost:3000)를 등록하세요.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# 세션 쿠키 서명용 비밀값 (길고 랜덤하게). 미설정 시 서버 재시작마다 세션이 초기화됩니다.
SESSION_SECRET=change-me-to-a-long-random-string

# 관리자 이메일 (쉼표로 여러 명 가능)
ADMIN_EMAILS=you@example.com

PORT=3000

# 리버스 프록시(Nginx, Cloudflare, Render 등) 뒤에서 실행할 때 실제 방문자 IP를 얻으려면 설정.
# 프록시 홉 수(예: 1)를 넣으세요. 프록시가 없는데 켜면 X-Forwarded-For 위조로 IP를 속일 수 있습니다.
TRUST_PROXY=

# 로컬 테스트 전용: NODE_ENV!=production 일 때만 동작하는 개발용 로그인
# DEV_LOGIN=1
